{
  "compilerOptions": {
    "target": "es2019",
    "module": "amd",
    "outFile": "../build/live2d.amd.js",
    "moduleResolution": "node",
    "lib": [
      "es2020",
      "dom"
    ],
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "removeComments": true,
    "skipLibCheck": true
  },
  "files": [
    "src/entry.ts",
    "src/index.ts"
  ],
  "include": [
    "types/*.d.ts"
  ]
}
